# Supabase project URL used for websocket authentication.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase service role key. Keep this server-only.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Postgres connection string used by the db workspace package.
# Use the pooler URL for deployed/serverless environments.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres"

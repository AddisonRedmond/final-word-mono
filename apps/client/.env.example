# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

# Supabase Postgres connection string for Drizzle (server-only).
# Use the pooler URL for deployed/serverless environments.
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres"

# Cloudflare Turnstile (CAPTCHA for anonymous "Play as guest" sign-in).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is the public site key rendered in the browser.
# TURNSTILE_SECRET_KEY is the server-only secret used to verify the token via the
# siteverify API. See https://developers.cloudflare.com/turnstile/.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
